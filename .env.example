# Storefront Supabase connection — READ ONLY.
# Use the anon / publishable key, never the service_role key: this file is
# bundled into the client-side JS at build time and is therefore public.
# Keep the `products` table restricted to SELECT for the `anon` role via RLS.
#
# Copy to .env and fill in from your Supabase project (.env is gitignored):
# Supabase → Project Settings → API Keys

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
